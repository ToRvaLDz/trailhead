---
// Overrides Starlight's <MarkdownContent>: reproduces the stock component
// (a `.sl-markdown-content` wrapper around `<slot />`) but injects the
// per-page decorative map-card hero (#112) as the FIRST child, before the
// slot, so it floats and the markdown prose (starting with the opening
// paragraph, right after the real `<h1 id="_top">` rendered by the stock
// PageTitle) wraps around it. `Astro.locals.starlightRoute.id` was verified
// empirically via a full `astro build` (see cards.ts) — the /docs/ index
// route's id is the bare "docs", every other page is "docs/<slug>". Pages
// with no matching card (only possible for a future/system route; all 10
// real docs pages are registered) fall through to rendering just the stock
// wrapper, so this is a safe no-op there.
import '@astrojs/starlight/style/markdown.css';
import MapCard from './MapCard.astro';
import { cards } from './cards';

const { id } = Astro.locals.starlightRoute;
const card = cards[id];
---

<div class="sl-markdown-content">
  {
    card && (
      <div class="docs-hero-float">
        <MapCard card={card} />
      </div>
    )
  }
  <slot />
</div>

<style>
  .docs-hero-float {
    float: right;
    width: 380px;
    margin: 0.25rem 0 1rem 1.75rem;
  }

  @media (max-width: 50rem) {
    .docs-hero-float {
      float: none;
      width: auto;
      max-width: 520px;
      margin-inline: 0;
    }
  }
</style>
