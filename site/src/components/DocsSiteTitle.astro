---
// Replaces Starlight's default <SiteTitle> so the /docs/ header shows the
// same wordmark as the landing nav (Nav.astro), linking back to the
// marketing home page at "/" rather than Starlight's own docs root.
// `data-brand-wordmark` is the seam anchor asserted by scripts/check-routes.mjs.
---

<a href="/" class="site-title sl-flex" data-brand-wordmark>
	<span class="t">trail</span><span class="h">head</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			/* No gap: the wordmark reads as one word ("trailhead"), contiguous
			   like the landing nav, not "trail head" split by the stock nav gap. */
			gap: 0;
			font-size: 20px;
			font-weight: 800;
			letter-spacing: -0.02em;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		.site-title .t {
			color: var(--fg);
		}
		.site-title .h {
			background: linear-gradient(92deg, var(--accent), var(--accent-2));
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
		}
	}
</style>
